node_modules/
dist/
*.tgz
.DS_Store
.env
.env.*
!.env.*.example
# Python (gitgraph package)
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.gitgraph/
# URL-target clone cache (ADR 0003) — a separate, larger category of local
# state than the per-repo .db files above; called out on its own so it's
# clear what's accumulating on disk.
.gitgraph/repos/
*.db
# Verity's derived state cache — never authoritative (framework-spec §5)
.verity-cache/
# Per-app deployment access (host + credential locations) — shared out-of-band,
# never committed. The committed pointer (.verity/deploy-access.README.md) stays.
.verity/deploy-access.md
